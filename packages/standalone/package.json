{
  "name": "@quotivity/cpq-inventory-standalone",
  "version": "0.2.0",
  "private": true,
  "description": "Standalone Node script for the Quotivity CPQ Inventory & Migration Analysis. Not yet published: runs from a checkout of the repository.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "cpq-inventory": "./bin/cpq-inventory.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quotivity/salesforce-cpq-migration-analysis.git",
    "directory": "packages/standalone"
  },
  "homepage": "https://github.com/quotivity/salesforce-cpq-migration-analysis",
  "exports": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "/bin",
    "/lib",
    "!/lib/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/standalone"
  },
  "dependencies": {
    "@quotivity/cpq-inventory-core": "0.2.0",
    "open": "^11.0.3"
  }
}
